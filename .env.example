# ==============================================================================
# Fraud Drift Detection Platform - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real secrets or machine-local credentials to version control.
# ==============================================================================

# Runtime Environment: development | staging | production
APP_ENV=development

# Microservice API Authentication
# In staging/production, must be >= 16 characters and not a known default.
API_KEY=replace-with-a-secure-random-32-char-key

# Serving Storage and Model Package Paths
# Relative paths are resolved against FRAUD_WORKSPACE or current working directory.
MODEL_BUNDLE_PATH=results/benchmark_runs/RUN_63D7CA7F68/models/adaptive
PREDICTION_DB=results/service/predictions.sqlite
MODEL_OUTPUT_DIR=results/service/models

# Database Configuration (Optional MySQL Server 9.7)
ENABLE_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fraud_user
DB_PASSWORD=
DB_NAME=fraud_drift_db

# Hardware Acceleration Configuration (GPU / CUDA)
USE_GPU=false
GPU_DEVICE=cpu

# Experiment Reproducibility
RANDOM_SEED=42
