# Database Configuration (MySQL or MSSQL or SQLite)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fraud_drift_db

# Fallback SQLite DB path (used if MySQL is not running)
SQLITE_DB_PATH=data/fraud_drift.db

# Hardware Acceleration Configuration (NVIDIA eGPU)
USE_GPU=true
GPU_DEVICE=cuda

# Experiment Reproducibility (NFR-1)
RANDOM_SEED=42
