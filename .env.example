# CPU by default; optional GPU can be enabled explicitly.
USE_GPU=false
GPU_DEVICE=cuda
RANDOM_SEED=42
APP_ENV=development
API_KEY=dev-secret-key
# Set this to the exported real-data model directory before serving.
# MODEL_BUNDLE_PATH=results/runs/RUN_YOUR_ID/models/adaptive
# PREDICTION_DB=results/service/predictions.sqlite
# MODEL_OUTPUT_DIR=results/service/models
# Optional experiment database adapter (enable_mysql=true requires a production password):
ENABLE_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fraud_drift_db
